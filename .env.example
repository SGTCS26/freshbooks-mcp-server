# ── Required ──────────────────────────────────────────────────────────────────
# Create a FreshBooks app at https://my.freshbooks.com/#/developer
FRESHBOOKS_CLIENT_ID=your_client_id_here
FRESHBOOKS_CLIENT_SECRET=your_client_secret_here

# ── HTTP / Custom Connector mode ───────────────────────────────────────────────
# Set MODE=http to run as an HTTP server (for claude.ai custom connector)
# Defaults to stdio (for MCP inspector / Claude Desktop)
# MODE=http

# Public base URL of this server (used to build the OAuth redirect URI)
# Defaults to https://localhost:3443 — override for production
# SERVER_URL=https://freshbooks-mcp.yourdomain.com

# Port for the HTTP server (defaults to 3443 for HTTPS mode, 3000 for plain HTTP)
# PORT=3443

# Set to false when running behind ngrok or another TLS proxy (they handle HTTPS)
# HTTPS=false

# ── Stdio mode ─────────────────────────────────────────────────────────────────
# When MODE=stdio (default), you can supply a pre-obtained FreshBooks access
# token directly so no browser OAuth is needed.
# FRESHBOOKS_ACCESS_TOKEN=your_access_token_here
# FRESHBOOKS_REFRESH_TOKEN=your_refresh_token_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Override the FreshBooks API base (rarely needed)
# FRESHBOOKS_API_BASE=https://api.freshbooks.com

# ── Tool exposure (read-only by default) ───────────────────────────────────────
# Read-only unless MCP_READ_ONLY is explicitly 0/false/off/no.
# NODE_ENV=production always forces read-only.
# MCP_READ_ONLY=true
# Optional comma-separated tool names. Write tools need to be listed here AND
# MCP_READ_ONLY off. Unknown names fail startup. Check with: node dist/index.js --print-tools
# TOOL_ALLOWLIST=list_clients,get_client

# Interface for the HTTP listener (HTTP mode). Unset or empty = 127.0.0.1 (loopback only).
# HOST=127.0.0.1

# Business the read-only bills tools are scoped to (bills tools refuse when unset)
# FRESHBOOKS_BUSINESS_ID=

# ── OAuth hardening (HTTP mode) ────────────────────────────────────────────────
# Bearer session lifetime (default 43200 = 12 h) and refresh token lifetime (default 30 days)
# SESSION_TTL_SECONDS=43200
# REFRESH_TTL_SECONDS=2592000
# Sessions/refresh tokens written before the hardening have no TTL or client
# binding. allow (default) keeps them working; deny rejects them (forces re-auth).
# OAUTH_LEGACY_SESSIONS=allow
# Registered OAuth clients (secret stored as SHA-256 only), mode 0600
# CLIENTS_FILE=~/.freshbooks-mcp/clients.json
